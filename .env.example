# Offline, deterministic demo is the default. Set live to try both public feeds.
DATA_MODE=demo
# Optional trusted RSS/Atom endpoints. No API keys are required.
NEWS_FEED_URL=https://feeds.bbci.co.uk/news/business/rss.xml
SOCIAL_FEED_URL=https://www.reddit.com/r/finance/.rss
# Relative or absolute writable location; keep outside public/.
RISK_STORE_PATH=.riskpulse/state.json
