{
  "name": "riskpulse-ai",
  "version": "1.0.0",
  "private": true,
  "description": "RiskPulse AI: explainable financial signals and synthetic portfolio stress testing",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "docs:architecture": "tsx scripts/generate-architecture.ts",
    "docs:presentation": "tsx scripts/generate-presentation.ts",
    "docs:generate": "npm run docs:architecture && npm run docs:presentation",
    "verify:api": "tsx scripts/verify-api.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jszip": "^3.10.2",
    "pptxgenjs": "4.0.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "overrides": {
    "image-size": "^2.0.4"
  }
}
